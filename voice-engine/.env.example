# Member 4 — Voice Engine Configuration

APP_NAME=Voice Engine
APP_ENV=development

# Member 3 AI Decision API Endpoint
# Default connection to Member 3 AI Backend running on port 8000:
AI_BACKEND_URL=http://127.0.0.1:8000
# Alternatively specify exact DECISION_API_URL: http://127.0.0.1:8000/v1/decide
# Set to 'disabled' or 'mock' to use deterministic mock decision simulation.
DECISION_API_URL=
DECISION_API_TIMEOUT_SECONDS=8.0
USER_NAME=Alex

# Speech-to-Text (STT) Configuration
# Options: 'disabled' (default), 'faster-whisper', 'mock'
STT_PROVIDER=disabled
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Text-to-Speech (TTS) Configuration
# Options: 'disabled' (default), 'edge-tts', 'mock'
TTS_PROVIDER=edge-tts
# Recommended Indian English: en-IN-NeerjaNeural (female) or en-IN-PrabhatNeural (male)
# Extensible Hindi option: hi-IN-SwaraNeural
TTS_VOICE=en-IN-NeerjaNeural

# Audio Upload & Storage Policy
MAX_AUDIO_MB=15
AUDIO_STORAGE_DIR=generated_audio
MAX_AUDIO_RETENTION_SECONDS=3600
